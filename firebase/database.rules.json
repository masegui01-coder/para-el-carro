{
  "rules": {
    // Nadie puede listar las salas: solo entra quien conoce el código.
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".read": "$code.matches(/^[A-HJ-NP-Z2-9]{5}$/)",
        ".write": "$code.matches(/^[A-HJ-NP-Z2-9]{5}$/)",
        ".validate": "newData.hasChild('meta')",
        "meta": {
          ".validate": "newData.hasChildren(['host', 'created', 'status', 'rounds', 'mode'])",
          "host": { ".validate": "newData.isString() && newData.val().length <= 24" },
          "created": { ".validate": "newData.isNumber()" },
          "status": { ".validate": "newData.val() === 'lobby' || newData.val() === 'playing' || newData.val() === 'final'" },
          "rounds": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 30" },
          "mode": { ".validate": "newData.val() === 'fecha' || newData.val() === 'numero' || newData.val() === 'mezcla'" },
          "$other": { ".validate": false }
        },
        "players": {
          "$pid": {
            ".validate": "$pid.length <= 24 && newData.hasChildren(['name', 'avatar', 'order'])",
            "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 14" },
            "avatar": { ".validate": "newData.isString() && newData.val().length <= 16" },
            "order": { ".validate": "newData.isNumber()" },
            "online": { ".validate": "newData.isBoolean()" },
            "$other": { ".validate": false }
          }
        },
        "actions": {
          "$aid": {
            ".validate": "newData.hasChildren(['pid', 'a']) && newData.child('pid').isString() && newData.child('a').isString()"
          }
        },
        "state": {
          ".validate": "newData.hasChildren(['phase'])"
        },
        "$other": { ".validate": false }
      }
    }
  }
}
