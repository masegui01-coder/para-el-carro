<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".ParaElCarroApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Para el Carro"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ParaElCarro">

        <!-- Analytics: sin datos para anuncios hasta que el jugador lo acepte (UMP; ver Metrics.setAdConsent) -->
        <meta-data android:name="google_analytics_default_allow_ad_storage" android:value="false" />
        <meta-data android:name="google_analytics_default_allow_ad_user_data" android:value="false" />
        <meta-data android:name="google_analytics_default_allow_ad_personalization_signals" android:value="false" />

        <!-- AdMob (IDs de prueba por defecto; ver app/build.gradle.kts) -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Invitación a sala: https://para-el-carro-91ke5.web.app/?sala=ABCDE
                 Verificado con /.well-known/assetlinks.json: se abre directamente en la app; si no la tienen, se juega en la web -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="para-el-carro-91ke5.web.app" />
                <data android:host="para-el-carro-91ke5.firebaseapp.com" />
            </intent-filter>
            <!-- Enlaces antiguos de GitHub Pages (sin verificar: Android pregunta con qué abrirlos) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="masegui01-coder.github.io" android:pathPrefix="/para-el-carro" />
            </intent-filter>
        </activity>
    </application>
</manifest>
